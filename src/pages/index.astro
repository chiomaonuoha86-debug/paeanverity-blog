---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<img src="/logo.png" alt="Paean Verity logo" class="hero-logo" />
				<h1>Paean Verity</h1>
				<p class="tagline">Truth, that transforms.</p>
				<div class="hero-links">
					<a href="/blog" class="btn">Read the Blog</a>
					<a href="https://selar.com/m/paean-verity1" class="btn" target="_blank">Shop Now</a>
				</div>
			</section>

			<section class="intro">
				<h2>What is Paean Verity?</h2>
				<p>
					Paean Verity creates scripture-anchored devotionals, coloring books, and
					printable resources for believers who want truth to shape their everyday
					lives — not just their Sunday mornings. Every product is built to help you
					surround yourself with God's word until it becomes second nature.
				</p>
			</section>

			<section class="cta">
				<h2>Follow Along</h2>
				<p>
					New devotionals, coloring pages, templates, and reflections are shared regularly on the
					<a href="/blog">blog</a>. Find visual inspiration on
					<a href="https://pin.it/2O9jRsN6k" target="_blank">Pinterest</a>, or explore
					the full shop on <a href="https://selar.com/m/paean-verity1" target="_blank">Selar</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		text-align: center;
		padding: 3em 0;
	}
	.hero-logo {
		width: 120px;
		margin-bottom: 1em;
	}
	.hero h1 {
		margin-bottom: 0.3em;
	}
	.tagline {
		font-family: 'Dancing Script', cursive;
		font-size: 1.6em;
		color: var(--accent);
		margin-bottom: 1.5em;
	}
	.hero-links {
		display: flex;
		gap: 1em;
		justify-content: center;
		flex-wrap: wrap;
	}
	.intro, .cta {
		padding: 2em 0;
		border-top: 1px solid rgba(244, 246, 245, 0.15);
	}
</style>
