---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/"><img src="/logo.png" alt="Paean Verity logo" class="logo" /> {SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://pin.it/2O9jRsN6k" target="_blank">
				<span class="sr-only">Follow Paean Verity on Pinterest</span>
				Pinterest
			</a>
			<a href="https://selar.com/m/paean-verity1" target="_blank">
				<span class="sr-only">Shop Paean Verity on Selar</span>
				Shop
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #052E21;
		box-shadow: 0 2px 8px rgba(0,0,0,25%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	.logo {
		height: 36px;
		vertical-align: middle;
		margin-right: 8px;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
		display: flex;
		align-items: center;
		color: #F4F6F5;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: #F4F6F5;
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
