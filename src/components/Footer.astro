---
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} Paean Verity. All rights reserved.
	<div class="social-links">
		<a href="https://pin.it/2O9jRsN6k" target="_blank">Pinterest</a>
		<a href="https://selar.com/m/paean-verity1" target="_blank">Shop</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: var(--bg);
		color: rgb(var(--gray));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: var(--accent);
	}
	.social-links a:hover {
		color: var(--accent-dark);
	}
</style>
